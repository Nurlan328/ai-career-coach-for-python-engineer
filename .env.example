# Copy to .env and fill in. All values are optional for local dev.
# NEVER put real secrets in this file — it is committed to git. Use .env (gitignored).

# --- App ---
DEBUG=true
API_PREFIX=/api

# --- Security ---
# Generate a strong key for production, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Default (zero setup): SQLite
DATABASE_URL=sqlite+aiosqlite:///./career_coach.db
# PostgreSQL (requires `pip install asyncpg`):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/career_coach

# --- LLM (Claude) ---
# Leave empty to run with the offline fallback (question bank + heuristic analysis).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=2000

# --- LLM provider ---
# auto (default) = Claude if ANTHROPIC_API_KEY is set, otherwise offline fallback.
# ollama = free local model via Ollama (https://ollama.com), no API key needed:
#   1. install Ollama, 2. `ollama pull qwen3:8b`, 3. set LLM_PROVIDER=ollama
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# --- Background jobs / cache ---
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
# CELERY_TASK_ALWAYS_EAGER=false

# --- Uploads ---
MAX_UPLOAD_MB=5
