# Copy to .env and fill in. All values are optional for local dev.
# NEVER put real secrets in this file — it is committed to git. Use .env (gitignored).

# --- App ---
DEBUG=true
API_PREFIX=/api

# --- Security ---
# Generate a strong key for production, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Default (zero setup): SQLite
DATABASE_URL=sqlite+aiosqlite:///./career_coach.db
# PostgreSQL (requires `pip install asyncpg`):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/career_coach

# --- LLM (Claude) ---
# Leave empty to run with the offline fallback (question bank + heuristic analysis).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=2000

# --- LLM provider ---
# auto (default) = Claude if ANTHROPIC_API_KEY is set, otherwise offline fallback.
# ollama = free local model via Ollama (https://ollama.com), no API key needed:
#   1. install Ollama, 2. `ollama pull qwen3:8b`, 3. set LLM_PROVIDER=ollama
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# --- Background jobs / cache ---
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
# CELERY_TASK_ALWAYS_EAGER=false

# --- Billing (Stripe) ---
# Leave STRIPE_SECRET_KEY empty for demo mode: "checkout" upgrades instantly,
# nothing is charged. Fill all three for real payments (test keys are enough).
#   1. Test secret key:  https://dashboard.stripe.com/test/apikeys
#   2. Recurring price:  Product catalog -> add product -> copy the price id
#   3. Webhook secret:   `stripe listen --forward-to localhost:8000/api/billing/webhook`
#      prints whsec_...; in production create the endpoint in the dashboard and
#      subscribe to: checkout.session.completed, customer.subscription.updated,
#      customer.subscription.deleted, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
# STRIPE_API_VERSION=2025-03-31.basil
BILLING_SUCCESS_URL=http://localhost:5173/billing?status=success
BILLING_CANCEL_URL=http://localhost:5173/billing?status=cancel
BILLING_PORTAL_RETURN_URL=http://localhost:5173/billing
FREE_INTERVIEWS_PER_MONTH=3
PRO_PRICE_USD=19

# --- Uploads ---
MAX_UPLOAD_MB=5
